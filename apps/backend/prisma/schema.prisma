// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PROFESSIONAL
  PATIENT
  AMBASSADOR
}

enum ProfessionalType {
  DOCTOR
  PSYCHOLOGIST
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  PENDING
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(PATIENT)
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientProfile      PatientProfile?
  professionalProfile ProfessionalProfile?
  subscriptions       Subscription[]
  donations           Donation[]

  @@map("users")
}

model PatientProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Smoking History
  smokingStartDate DateTime?
  dailyCigarettes  Int?
  
  // Status & Progress
  isSmokeFree   Boolean   @default(false)
  quitDate      DateTime?
  smokeFreeDays Int       @default(0)
  
  // Orientation
  assignedDoctorId      String?
  assignedPsychologistId String?

  testResults TestResult[]

  @@map("patient_profiles")
}

model ProfessionalProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  type           ProfessionalType
  specialization String?
  bio            String?
  
  @@map("professional_profiles")
}

model Pack {
  id          String   @id @default(uuid())
  name        String   // e.g., "Pack 1 Mois", "Pack 3 Mois"
  duration    Int      // Duration in months
  price       Float
  description String?
  
  subscriptions Subscription[]

  @@map("packs")
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  packId    String
  pack      Pack               @relation(fields: [packId], references: [id])
  startDate DateTime           @default(now())
  endDate   DateTime
  status    SubscriptionStatus @default(PENDING)
  amount    Float

  @@map("subscriptions")
}

model Donation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  createdAt DateTime @default(now())
  message   String?

  @@map("donations")
}

model TestResult {
  id        String   @id @default(uuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id])
  testType  String   // e.g., "INITIAL_EVALUATION"
  score     Int?
  data      Json     // Raw test answers/results
  createdAt DateTime @default(now())

  @@map("test_results")
}
